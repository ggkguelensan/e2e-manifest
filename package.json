{
  "name": "e2e-manifest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "setup": "node scripts/setup.ts",
    "check": "node scripts/check.ts",
    "test": "node --test tests/*.test.ts",
    "hooks:install": "lefthook install",
    "validate:evidence": "node scripts/evidence.ts",
    "validate:coverage": "node scripts/coverage.ts",
    "report": "node scripts/report.ts",
    "test:browser": "node tests/browser-flow.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "lefthook": "2.2.2"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "csv-parse": "7.0.3"
  }
}
