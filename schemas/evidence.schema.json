{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "case_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "step_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "captured_at": {
            "type": "string",
            "format": "date-time"
          },
          "kind": {
            "enum": [
              "screenshot",
              "trace",
              "log",
              "attachment"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:])[^\\s]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "mime": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "conditions": {
            "oneOf": [
              {
                "$ref": "#/$defs/uiConditions"
              },
              {
                "$ref": "#/$defs/nonBrowserConditions"
              }
            ]
          }
        },
        "required": [
          "id",
          "case_id",
          "step_id",
          "captured_at",
          "kind",
          "path",
          "sha256",
          "mime",
          "description",
          "conditions"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "screenshot"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "conditions": {
                  "$ref": "#/$defs/uiConditions"
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "items"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ggkguelensan.github.io/e2e-manifest/schemas/evidence.schema.json",
  "$defs": {
    "uiConditions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "width",
            "height"
          ]
        },
        "dpr": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "theme": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "locale": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "viewport",
        "dpr",
        "theme",
        "locale",
        "state"
      ]
    },
    "nonBrowserConditions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "execution": {
          "const": "non-browser"
        },
        "environment": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "execution",
        "environment",
        "state"
      ]
    }
  }
}
