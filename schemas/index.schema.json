{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generated_by": {
      "const": "e2e-manifest:index"
    },
    "target_root": {
      "type": "string",
      "minLength": 1
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "run_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "run": {
            "$ref": "#/$defs/source"
          },
          "evidence": {
            "$ref": "#/$defs/source"
          }
        },
        "required": [
          "run_id",
          "run",
          "evidence"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "generated_by",
    "target_root",
    "runs"
  ],
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^runs/[a-z0-9]+(?:-[a-z0-9]+)*/(?:run|evidence)\\.json$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
