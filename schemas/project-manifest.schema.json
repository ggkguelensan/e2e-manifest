{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "E2E local adaptation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "base",
    "patches",
    "repository_id",
    "target_id",
    "modules"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "revision"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*://)(?!.*\\\\).+$"
        },
        "revision": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        }
      }
    },
    "patches": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^patches/[a-z0-9]+(?:-[a-z0-9]+)*\\.json$"
      }
    },
    "repository_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "target_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "modules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "playwright",
          "msw"
        ]
      }
    }
  }
}
