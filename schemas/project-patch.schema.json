{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "E2E Manifest project patch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "status",
    "base_revision",
    "topic",
    "scope",
    "target",
    "mode",
    "reason",
    "requirements",
    "verification",
    "revision",
    "updated_at",
    "resources"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "status": {
      "enum": [
        "proposed",
        "active"
      ]
    },
    "base_revision": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "topic": {
      "enum": [
        "scenarios",
        "ui",
        "environment",
        "contracts",
        "runtime",
        "verification",
        "workflow"
      ]
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(\\.|(?!.*(?:^|/)\\.\\.(?:/|$))[^/\\\\:]+(?:/[^/\\\\:]+)*)$"
      }
    },
    "target": {
      "type": "string",
      "pattern": "^docs/[a-z0-9-]+\\.md#[^\\s#]+$"
    },
    "mode": {
      "enum": [
        "supplement",
        "override"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "decision_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "reviewed_at",
        "review_due_at"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "review_due_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "kind",
          "summary",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "path": {
            "type": "string",
            "pattern": "^manifest/resources/(?:[a-z0-9]+(?:-[a-z0-9]+)*/)*[a-z0-9]+(?:-[a-z0-9]+)*\\.md$"
          },
          "kind": {
            "enum": [
              "rules",
              "reference"
            ]
          },
          "summary": {
            "type": "string",
            "pattern": "\\S"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "read_when": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "reference"
                }
              }
            },
            "then": {
              "required": [
                "read_when"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "rules"
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "read_when"
                ]
              }
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "override"
          }
        }
      },
      "then": {
        "required": [
          "decision_ref"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "active"
          }
        }
      },
      "then": {
        "required": [
          "review"
        ]
      }
    }
  ]
}
